"""
PostExploitAgent — The Persistence Hunter
==========================================
Tools: LinPEAS (if available), custom Python privilege escalation checks
Output: privilege escalation paths, credential exposure, persistence mechanisms
"""
from __future__ import annotations
import asyncio
import os
import shutil
from pathlib import Path
from .base import BaseAgent, AgentResult
import logging

logger = logging.getLogger(__name__)

class PostExploitAgent(BaseAgent):
    name = "PostExploitAgent"
    description = "Post-exploitation: privilege escalation, credential hunting, persistence"

    async def run(self, target: dict, context: dict) -> AgentResult:
        findings = []
        outputs = {}

        # ── LinPEAS ────────────────────────────────────────────────────────────
        if shutil.which("linpeas.sh") or Path("/opt/linpeas.sh").exists():
            lp_result = await self._run_linpeas()
            outputs["linpeas"] = lp_result[:5000]  # truncate
        else:
            outputs["linpeas"] = "linpeas not found; run: curl -o /opt/linpeas.sh https://linpeas.sh"

        # ── Python-based checks ───────────────────────────────────────────────
        privesc_findings = await self._python_privesc_check()
        findings.extend(privesc_findings)
        outputs["python_checks"] = f"{len(privesc_findings)} checks run"

        return AgentResult(
            agent_name=self.name,
            status="success",
            findings=findings,
            tool_outputs=outputs,
        )

    async def _run_linpeas(self) -> str:
        linpeas_path = shutil.which("linpeas.sh") or "/opt/linpeas.sh"
        cmd = ["bash", linpeas_path, "-a"]
        try:
            proc = await asyncio.create_subprocess_exec(
                *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=300)
            return stdout.decode(errors="replace")
        except Exception as e:
            return f"linpeas error: {e}"

    async def _python_privesc_check(self) -> list[dict]:
        """Heuristic privilege escalation checks."""
        findings = []

        # Check SUID binaries
        try:
            proc = await asyncio.create_subprocess_exec(
                "find", "/", "-perm", "-4000", "-type", "f",
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=30)
            suids = stdout.decode(errors="replace").strip().splitlines()
            dangerous = [s for s in suids if any(x in s for x in ["nmap", "vim", "find", "bash", "more", "less", "python"])]
            if dangerous:
                findings.append(self._make_finding(
                    title="Dangerous SUID Binaries Found",
                    severity="high",
                    description=f"SUID binaries that may allow privilege escalation: {', '.join(dangerous)}",
                    confidence=0.9,
                ))
        except Exception:
            pass

        # Check writable /etc/passwd
        if os.access("/etc/passwd", os.W_OK):
            findings.append(self._make_finding(
                title="Writable /etc/passwd",
                severity="critical",
                description="/etc/passwd is world-writable; attacker can add root user",
                confidence=1.0,
            ))

        # Check sudo -l
        try:
            proc = await asyncio.create_subprocess_exec(
                "sudo", "-l", "-n",
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE
            )
            stdout, _ = await asyncio.wait_for(proc.communicate(), timeout=10)
            sudo_out = stdout.decode(errors="replace")
            if "NOPASSWD" in sudo_out:
                findings.append(self._make_finding(
                    title="Sudo NOPASSWD Entries Found",
                    severity="high",
                    description=f"sudo -l output: {sudo_out[:500]}",
                    confidence=0.95,
                ))
        except Exception:
            pass

        return findings
