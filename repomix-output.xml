<file path="frontend/src/components/charts/AgentTimeline.tsx">
'use client';

import { CheckCircle, Clock, Loader2, XCircle } from 'lucide-react';
import type { AgentRun } from '@/lib/types';

interface AgentTimelineProps {
  runs: AgentRun[];
}

const statusConfig = {
  pending: {
    icon: Clock,
    color: 'text-muted',
    bg: 'bg-muted/10 border-muted/30',
    line: 'bg-muted/30',
  },
  running: {
    icon: Loader2,
    color: 'text-accent',
    bg: 'bg-accent/10 border-accent/30',
    line: 'bg-accent/30',
  },
  completed: {
    icon: CheckCircle,
    color: 'text-success',
    bg: 'bg-success/10 border-success/30',
    line: 'bg-success/30',
  },
  failed: {
    icon: XCircle,
    color: 'text-danger',
    bg: 'bg-danger/10 border-danger/30',
    line: 'bg-danger/30',
  },
};

function formatTime(iso: string) {
  return new Date(iso).toLocaleTimeString([], {
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
  });
}

function formatDuration(start: string, end?: string) {
  if (!end) return 'In progress';
  const ms = new Date(end).getTime() - new Date(start).getTime();
  const seconds = Math.floor(ms / 1000);
  if (seconds < 60) return `${seconds}s`;
  return `${Math.floor(seconds / 60)}m ${seconds % 60}s`;
}

export default function AgentTimeline({ runs }: AgentTimelineProps) {
  if (!runs.length) {
    return (
      <div className="flex h-32 items-center justify-center rounded-xl border border-border bg-surface">
        <p className="text-sm text-muted">No agent runs yet</p>
      </div>
    );
  }

  const sorted = [...runs].sort(
    (a, b) => new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  );

  return (
    <div className="rounded-xl border border-border bg-surface p-5">
      <h3 className="mb-4 text-sm font-semibold text-white">Agent Run Timeline</h3>
      <div className="space-y-0">
        {sorted.map((run, index) => {
          const config = statusConfig[run.status];
          const Icon = config.icon;
          const isLast = index === sorted.length - 1;

          return (
            <div key={run.id} className="flex gap-4">
              <div className="flex flex-col items-center">
                <div
