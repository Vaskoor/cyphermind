  ready: 'bg-success/15 text-success',
  failed: 'bg-danger/15 text-danger',
};

const typeStyles: Record<string, string> = {
  recon: 'bg-cyan-500/15 text-cyan-400',
  combined: 'bg-accent/15 text-accent',
  executive: 'bg-purple-500/15 text-purple-400',
  findings: 'bg-orange-500/15 text-orange-400',
};

export default function ReportsPage() {
  const [reports, setReports] = useState<Report[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [downloading, setDownloading] = useState<string | number | null>(null);

  const fetchReports = async () => {
    setLoading(true);
    try {
      const data = await reportsApi.list();
      setReports(data);
      setError('');
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchReports();
  }, []);

  const handleDownload = async (report: Report) => {
    setDownloading(report.id);
    try {
      const blob = await reportsApi.download(report.id);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${report.title.replace(/[^a-z0-9-_]/gi, '_')}.${report.format}`;
      a.click();
      URL.revokeObjectURL(url);
    } catch (err) {
      setError(getErrorMessage(err));
    } finally {
      setDownloading(null);
    }
  };

  if (loading) {
    return (
      <div className="flex h-96 items-center justify-center">
        <LoadingSpinner size="lg" label="Loading reports..." />
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold text-white">Reports</h1>
          <p className="mt-1 text-sm text-muted">
            Auto-generated recon and assessment reports — one per agent after each run
          </p>
        </div>
        <button
          onClick={fetchReports}
          className="flex items-center gap-2 rounded-lg border border-border px-3 py-2 text-sm text-muted transition-colors hover:border-accent/30 hover:text-white"
        >
          <RefreshCw className="h-4 w-4" />
          Refresh
        </button>
      </div>

      {error && (
        <div className="rounded-lg border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger">
          {error}
        </div>
      )}

      {reports.length === 0 ? (
        <div className="flex h-64 flex-col items-center justify-center rounded-xl border border-border bg-surface">
          <FileText className="mb-3 h-10 w-10 text-muted" />
          <p className="text-sm text-muted">No reports generated yet</p>
          <p className="mt-1 text-xs text-muted">
            Run a bug bounty hunt or engagement — reports appear here automatically
          </p>
        </div>
      ) : (
        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {reports.map((report) => (
            <div
              key={report.id}
              className="group rounded-xl border border-border bg-surface p-5 transition-all hover:border-accent/30 hover:shadow-glow-sm"
            >
              <div className="mb-3 flex items-start justify-between gap-2">
                <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent/10">
                  <FileText className="h-5 w-5 text-accent" />
                </div>
                <div className="flex flex-wrap gap-1 justify-end">
                  {report.report_type && (
                    <span
                      className={`rounded-full px-2 py-0.5 text-xs font-medium capitalize ${
                        typeStyles[report.report_type] || 'bg-muted/20 text-muted'
                      }`}
                    >
                      {report.report_type}
                    </span>
                  )}
                  <span
                    className={`rounded-full px-2 py-0.5 text-xs font-medium capitalize ${statusStyles[report.status]}`}
                  >
                    {report.status}
                  </span>
                </div>
              </div>

              <h3 className="mb-1 text-sm font-semibold text-white line-clamp-2">
                {report.title}
              </h3>
              <p className="mb-1 text-xs text-muted">
                {report.agent_name && <span className="text-accent">{report.agent_name}</span>}
                {report.agent_name && ' · '}
                {new Date(report.created_at).toLocaleString()} · {report.format.toUpperCase()}
              </p>
              {report.findings_count !== undefined && report.report_type !== 'recon' && (
                <p className="mb-4 text-xs text-muted">{report.findings_count} finding(s)</p>
              )}
              {report.report_type === 'recon' && (
                <p className="mb-4 text-xs text-cyan-400">Recon intelligence report</p>
              )}

              {report.status === 'ready' && (
                <div className="flex gap-2">
                  <a
                    href={reportsApi.getHtmlUrl(report.id)}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex flex-1 items-center justify-center gap-1 rounded-lg bg-background py-2 text-xs font-medium text-white transition-colors hover:bg-background/80"
                  >
                    <Eye className="h-3.5 w-3.5" />
                    View
                  </a>
                  <button
                    onClick={() => handleDownload(report)}
                    disabled={downloading === report.id}
                    className="flex flex-1 items-center justify-center gap-1 rounded-lg bg-accent/10 py-2 text-xs font-medium text-accent transition-colors hover:bg-accent/20"
                  >
                    {downloading === report.id ? (
                      <Loader2 className="h-3.5 w-3.5 animate-spin" />
                    ) : (
                      <Download className="h-3.5 w-3.5" />
                    )}
                    Save
                  </button>
                </div>
              )}

              {report.engagement_id && (
                <Link
                  href={`/engagements/${report.engagement_id}`}
                  className="mt-2 flex items-center gap-1 text-xs text-muted hover:text-accent"
                >
                  <ExternalLink className="h-3 w-3" />
                  Engagement #{report.engagement_id}
                </Link>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
</file>

<file path="frontend/src/app/selfplay/page.tsx">
'use client';

import { useState } from 'react';
import { Loader2, Play, Swords } from 'lucide-react';
import { getErrorMessage, selfPlayApi } from '@/lib/api';
import { useToast } from '@/components/ui/Toast';
import type { SelfPlayGame } from '@/lib/types';

const SAMPLE_CODE = `from flask import request
import os

def process_user_input():
    cmd = request.args.get('cmd', '')
    result = os.system(cmd)  # VULNERABLE: OS injection
    return str(result)
`;

export default function SelfPlayPage() {
  const { success, error: toastError } = useToast();
  const [code, setCode] = useState(SAMPLE_CODE);
  const [gameId, setGameId] = useState<number | null>(null);
  const [status, setStatus] = useState<SelfPlayGame | null>(null);
  const [loading, setLoading] = useState(false);

  const poll = (id: number) => {
    const interval = setInterval(async () => {
      try {
        const data = await selfPlayApi.status(id);
        setStatus(data);
        if (data.status === 'completed') clearInterval(interval);
      } catch {
        clearInterval(interval);
      }
    }, 3000);
  };

  const handleStart = async () => {
    setLoading(true);
    try {
      const data = await selfPlayApi.start(code, 'python', 3);
      const id = data.game_id ?? data.id;
      if (id) {
        setGameId(id);
        poll(id);
      }
      success('Self-play started', 'Red vs Blue battle initiated');
    } catch (err) {
      toastError('Failed to start', getErrorMessage(err));
    } finally {
      setLoading(false);
    }
  };

  const winnerColor = status?.winner === 'red' ? 'text-red-400' : 'text-green-400';

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-white flex items-center gap-2">
          <Swords className="h-6 w-6 text-accent" />
          Self-Play Arena
        </h1>
        <p className="mt-1 text-sm text-muted">
          Red Team LLM attacks, Blue Team LLM defends. Novel patterns flagged for KB ingestion.
        </p>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div className="rounded-xl border border-border bg-surface p-5">
          <label className="block text-sm font-medium text-slate-300 mb-2">Target Code (Python)</label>
          <textarea
            className="w-full h-64 bg-background border border-border rounded-lg p-4 text-green-400 font-mono text-sm focus:outline-none focus:border-accent"
            value={code}
            onChange={(e) => setCode(e.target.value)}
          />
          <button
            onClick={handleStart}
            disabled={loading || status?.status === 'running'}
            className="mt-4 w-full flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 disabled:opacity-50 text-white py-3 rounded-lg font-medium transition"
          >
            {loading ? <Loader2 className="h-4 w-4 animate-spin" /> : <Play className="h-4 w-4" />}
            {status?.status === 'running' ? 'Battle in progress...' : 'Start Red vs Blue'}
          </button>
        </div>

        <div className="rounded-xl border border-border bg-surface p-6">
          <h2 className="text-white font-semibold mb-4">Game Status</h2>
          {!status && <p className="text-muted">No game running yet.</p>}
          {status && (
            <div className="space-y-3 text-sm">
              <div className="flex justify-between">
                <span className="text-muted">Status:</span>
                <span className={status.status === 'completed' ? 'text-green-400' : 'text-yellow-400'}>
                  {status.status}
                </span>
              </div>
              {status.winner && (
                <div className="flex justify-between">
                  <span className="text-muted">Winner:</span>
                  <span className={`font-bold ${winnerColor}`}>{status.winner.toUpperCase()} TEAM</span>
                </div>
              )}
              <div className="flex justify-between">
                <span className="text-muted">Rounds:</span>
                <span className="text-white">{status.total_rounds ?? 0}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-muted">Novel Patterns:</span>
                <span className="text-yellow-400 font-bold">{status.novel_patterns_found ?? 0}</span>
              </div>
              {gameId && <p className="text-xs text-muted font-mono">Game ID: {gameId}</p>}
            </div>
          )}
        </div>
      </div>

      <div className="grid grid-cols-2 gap-4">
        <div className="rounded-xl border border-red-800/50 bg-red-900/10 p-4">
          <h3 className="text-red-400 font-semibold mb-2">Red Team (Offensive)</h3>
          <p className="text-muted text-sm">Temperature: 0.9 — find exploitable vulnerabilities</p>
        </div>
        <div className="rounded-xl border border-blue-800/50 bg-blue-900/10 p-4">
          <h3 className="text-blue-400 font-semibold mb-2">Blue Team (Defensive)</h3>
          <p className="text-muted text-sm">Temperature: 0.1 — patch vulnerabilities</p>
        </div>
      </div>
    </div>
  );
}
</file>

