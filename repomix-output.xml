    animation: animate-in 0.3s ease-out;
  }

  .slide-in-from-right {
    animation: slide-in-from-right 0.3s ease-out;
  }
}

@keyframes animate-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slide-in-from-right {
  from {
    opacity: 0;
    transform: translateX(1rem);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* Form inputs */
input,
textarea,
