# ── LLM Providers ─────────────────────────────────────────────────────────────
# Change provider per task without editing code:
#   LLM_PROVIDER_BUG_BOUNTY=nvidia   → Kimi via NVIDIA NIM
#   LLM_PROVIDER_SELFPLAY=grok         → Grok for red/blue arena
#   LLM_PROVIDER_RAG=nvidia
#   LLM_PROVIDER_CHAT=grok

LLM_DEFAULT_PROVIDER=nvidia
LLM_TIMEOUT_SECONDS=180

# NVIDIA / Kimi (provider names: nvidia or kimi)
NVIDIA_API_KEY=your_kimi_key_here
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
LLM_MODEL=moonshotai/kimi-k2.6

# Grok / xAI (provider name: grok)
GROK_API_KEY=your_grok_key_here
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

LLM_CUSTOM_API_KEY=your_groq_key_here
LLM_CUSTOM_API_BASE=https://api.groq.com/openai/v1
LLM_CUSTOM_MODEL=llama-3.3-70b-versatile

# OpenAI (provider name: openai)
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# OpenRouter (provider name: openrouter)
# OPENROUTER_API_KEY=

# Per-role provider overrides (optional)
LLM_PROVIDER_BUG_BOUNTY=nvidia
LLM_PROVIDER_SELFPLAY=custom
LLM_PROVIDER_SELFPLAY_RED=custom
LLM_PROVIDER_SELFPLAY_BLUE=custom
LLM_PROVIDER_RAG=nvidia        # or custom
LLM_PROVIDER_CHAT=custom
LLM_PROVIDER_AGENT=nvidia

# ── Fine-tuning (separate module — disabled by default) ─────────────────────
# Set FINETUNING_ENABLED=true only after you have a trained model ID
FINETUNING_ENABLED=false
FINETUNING_MODEL_ID=ft:your-model-id-here
FINETUNING_BASE_PROVIDER=nvidia
# FINETUNING_API_BASE=          # optional — inherits from base provider
# FINETUNING_API_KEY=           # optional — inherits from base provider key
FINETUNING_ROLES=bug_bounty,agent
FINETUNING_AUTO_EXPORT=false    # export JSONL dataset after each hunt
FINETUNING_SUPPORTS_TOOLS=true

# ── Web search ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── Bug bounty ────────────────────────────────────────────────────────────────
BUG_BOUNTY_MAX_ITERATIONS=15

EMBEDDING_MODEL=all-MiniLM-L6-v2
